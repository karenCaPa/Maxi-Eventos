# ============================================================================
# Maxi Eventos — variables de entorno de EJEMPLO (solo para desarrollo).
# Copia este archivo a .env y CAMBIA los valores antes de usarlo en serio:
#     Copy-Item .env.example .env
# Ningún valor de este archivo es real. Nunca subas el archivo .env al repositorio.
# ============================================================================

# --- PostgreSQL (una sola base de datos compartida: maxi_eventos) ---
POSTGRES_DB=maxi_eventos
POSTGRES_USER=maxi_app
POSTGRES_PASSWORD=cambiar_esta_clave_de_bd

# --- Redis ---
REDIS_PASSWORD=cambiar_password_redis

# --- Kafka (modo KRaft) ---
# ID fijo del clúster (opcional; si se omite se usa el valor del compose). Debe ser siempre el mismo: el volumen
# kafka_data queda formateado con él. Si se cambia, hay que borrar el volumen kafka_data.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- JWT (la MISMA clave en todos los servicios; mínimo 32 caracteres) ---
AUTH_JWT_SECRET=cambiar_esta_clave_jwt_de_ejemplo_minimo_32_caracteres

# --- Usuaria organizadora (auth-service) ---
AUTH_ORGANIZER_EMAIL=organizadora@maxieventos.com
# Id opaco (UUID) de la organizadora: es el "sub" del JWT, para no poner el correo en el token. No es un secreto
# (opcional: si se omite, el compose usa este mismo valor).
AUTH_ORGANIZER_ID=3f6c1b9e-2d4a-4e8f-b7a5-9c0d1e2f3a4b
# ⚠ CREDENCIAL DE EJEMPLO: la contraseña de abajo es pública. Rótala SIEMPRE en cada entorno (ver docs/seguridad.md).
# Hash BCrypt de la contraseña de ejemplo "CambiarEsta.2026" (SOLO para desarrollo, cámbiala).
# Va entre comillas simples para que Docker Compose no interprete los caracteres '$'.
# Para generar otro hash: scripts\verificacion\rotar-password.ps1 (ver README, sección 3).
AUTH_ORGANIZER_PASSWORD_HASH='$2a$10$xlKlgm0Ie3KBXn65vgwAZuetMkrbZF2/Q7ORb2VMnq6VuKbYpK0J.'
# Nombre que se muestra en la barra de la interfaz (opcional; no viaja en el token). Su rol es ADMINISTRADOR.
AUTH_ORGANIZER_NOMBRE=Organizadora

# --- Usuario ASISTENTE (auth-service, Fase 11D) ---
# Gestiona clientes y el flujo de los eventos; NO administra lugares, proveedores, el bloqueo de fechas ni la auditoría
# (matriz completa en docs/seguridad.md). Para generar en el .env una contraseña aleatoria y su hash sin verlos:
#   powershell -ExecutionPolicy Bypass -File scripts\verificacion\rotar-password.ps1 -Usuario asistente
AUTH_ASISTENTE_EMAIL=asistente@maxieventos.com
# Id opaco (UUID) del asistente = "sub" de su JWT. No es un secreto (opcional: si se omite, el compose usa este valor).
AUTH_ASISTENTE_ID=9b1e7c4a-2f3d-4a5b-8c6d-7e8f9a0b1c2d
AUTH_ASISTENTE_NOMBRE=Asistente
# ⚠ CREDENCIAL DE EJEMPLO: hash BCrypt de la contraseña pública "CambiarEsta.Asistente.2026". Rótala SIEMPRE.
AUTH_ASISTENTE_PASSWORD_HASH='$2a$10$S4RkUBXXJZ4ZKJVe9SLD7unU8PtOAgm4ALIkM6gc9LboVfmSDFIq6'
# Vigencia del token en formato ISO-8601 (PT8H = 8 horas)
AUTH_TOKEN_TTL=PT8H

# --- Scripts de verificación (scripts/verificacion; no lo usa ningún servicio) ---
# Contraseña en claro de la organizadora para que los scripts hagan login. Opcional: si se deja vacía,
# el script la pide con Read-Host (sin mostrarla). Nunca se escribe en los scripts.
VERIFICACION_PASSWORD=
# Fase 11D: contraseña en claro del ASISTENTE, solo para los scripts y Newman (casos de 403). La escribe
# rotar-password.ps1 -Usuario asistente. Si está vacía, esos casos piden la contraseña o se omiten.
VERIFICACION_ASISTENTE_PASSWORD=

# --- Eventos: días en que la empresa trabaja (opcional; por defecto FRIDAY,SATURDAY,SUNDAY) ---
# Solo se registran eventos en estos días (nombres en inglés separados por comas). No es un secreto.
DIAS_PERMITIDOS=FRIDAY,SATURDAY,SUNDAY

# --- Zona horaria (opcional, no es un secreto; por defecto America/Bogota) ---
# La usan Eventos (recordatorios), Notificaciones (textos) y, desde la Fase 11H, la interfaz (horas de la campanita, por
# /config.js). Debe ser una zona IANA; si no lo es, el contenedor frontend no arranca.
# ZONA_HORARIA=America/Bogota

# --- Eventos: recordatorios EVENTO_PROXIMO (Fase 11E; opcionales, no son secretos) ---
# Días antes del evento en que se envía el recordatorio al cliente (se usa el umbral más pequeño que aplica).
RECORDATORIOS_DIAS=7,1
# Cuándo corre la revisión automática (cron de Spring: segundo minuto hora día mes día-semana, en America/Bogota).
# Por defecto todos los días a las 7:00. "-" la desactiva y solo queda el botón "Ejecutar recordatorios" (ADMINISTRADOR):
# conviene el día de la presentación, para que la tarea no envíe el recordatorio antes de mostrarlo.
# RECORDATORIOS_CRON='0 0 7 * * *'
# RECORDATORIOS_CRON=-

# --- Finanzas: tarifas de ejemplo (opcionales; si se omiten se usan los valores del compose) ---
FINANZAS_MONEDA=COP
# Cotización (TODO valor real). Cupo de invitados incluidos en el valor base:
#   SEPARADO = adultos y niños por separado (*_ADULTOS_INCLUIDOS y *_NINOS_INCLUIDOS)
#   UNICO    = un solo cupo (*_INVITADOS_INCLUIDOS) que cubre primero a los adultos
# Pendiente confirmar con la organizadora cuál aplica.
FINANZAS_MODO_CUPO=SEPARADO
# Recargo en zona RURAL sobre el subtotal (0.10 = 10 %)
FINANZAS_RECARGO_RURAL=0.10
FINANZAS_QUINCE_VALOR_BASE=8000000
FINANZAS_QUINCE_ADULTOS_INCLUIDOS=80
FINANZAS_QUINCE_NINOS_INCLUIDOS=20
FINANZAS_QUINCE_INVITADOS_INCLUIDOS=100
FINANZAS_QUINCE_VALOR_ADULTO_ADICIONAL=70000
FINANZAS_QUINCE_VALOR_NINO_ADICIONAL=40000
FINANZAS_BODA_VALOR_BASE=12000000
FINANZAS_BODA_ADULTOS_INCLUIDOS=100
FINANZAS_BODA_NINOS_INCLUIDOS=10
FINANZAS_BODA_INVITADOS_INCLUIDOS=110
FINANZAS_BODA_VALOR_ADULTO_ADICIONAL=90000
FINANZAS_BODA_VALOR_NINO_ADICIONAL=50000
# Porcentaje del total de la cotización exigido como depósito para confirmar el evento (TODO valor real)
FINANZAS_RESERVA_PORCENTAJE=0.30
FINANZAS_ADICIONAL_DECORACION_PREMIUM=250000
FINANZAS_ADICIONAL_HORA_EXTRA=120000
FINANZAS_ADICIONAL_TRANSPORTE=180000

# --- auditoria-service (8087) y notificaciones-service (8089) ---
# No necesitan variables propias: usan las comunes de arriba (PostgreSQL, Kafka y AUTH_JWT_SECRET). No usan Redis.

# --- gateway GraphQL (8090) ---
# Perfil de Spring del gateway: dev = GraphiQL habilitado en http://localhost:8090/graphiql (solo para desarrollo).
# Vacío = GraphiQL apagado (el endpoint /graphql sigue funcionando).
GATEWAY_SPRING_PROFILES=dev
# CORS: orígenes del navegador (frontend) que pueden llamar a /graphql, separados por comas. Obligatoria.
# Nunca "*" (el gateway no arranca). Los servicios internos no necesitan CORS: el navegador solo habla con el gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- interfaz web (5173, Fase 10C) ---
# URL del gateway TAL COMO LA VE EL NAVEGADOR (no la red interna de Docker). Opcional; por defecto http://localhost:8090.
# Se aplica al arrancar el contenedor (nginx genera /config.js y la CSP): no hace falta reconstruir la imagen.
# Solo un origen: esquema, host y puerto, sin ruta ni barra final (si no, el contenedor no arranca). No es un secreto.
# El origen de la interfaz (http://localhost:5173) debe estar en CORS_ALLOWED_ORIGINS.
FRONTEND_GATEWAY_URL=http://localhost:8090

# MODO DEMOSTRACIÓN (Fase 11I, opcional): una fecha AAAA-MM-DD que la INTERFAZ usa como "hoy" para lo que calcula ella
# (Realizado / Vencido, "Eventos pasados", "Próximos 7 días", calendario de Nuevo evento) y que avisa en la barra
# ("Modo demostración: fecha simulada …"). El BACKEND no cambia: sigue con su reloj real. Sin definir (lo normal) = fecha
# real. Activar: descomentar y `docker compose up -d frontend`; desactivar: volver a comentarla y el mismo comando.
# Una fecha que no existe impide que el contenedor arranque. Ejemplo para mostrar eventos pasados con la demostración:
# FRONTEND_FECHA_SIMULADA=2026-12-10
