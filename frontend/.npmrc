save-exact=true
fund=false
audit=false
# npm 10.9 falla ("Cannot read properties of null (reading 'edgesOut')") al recorrer las dependencias peer OPCIONALES
# encadenadas de vite 8 (@vitejs/devtools -> devtools-vitest -> vitest@*). Con legacy-peer-deps no las instala; todos
# los peers OBLIGATORIOS (react, react-dom, @testing-library/dom, vite) están declarados en package.json.
legacy-peer-deps=true
